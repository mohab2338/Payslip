# Android
android/local.properties
android/.gradle/
# Firebase config files — by default these are committed to the repo so
# GitHub Actions can build without needing repo secrets (see README.md step 3).
# If you'd rather keep them out of git history, uncomment these two lines
# and use the GOOGLE_SERVICES_JSON / FIREBASE_OPTIONS_DART repo secrets instead:
# android/app/google-services.json
# lib/firebase_options.dart
android/**/gradle-wrapper.jar
android/key.properties
*.jks
*.keystore

