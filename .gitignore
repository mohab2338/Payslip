ios/Flutter/.last_build_id
ios/Pods/
ios/.symlinks/
ios/Runner.xcworkspace/
ios/Flutter/Flutter.podspec
**/GoogleService-Info.plist

# Firebase generated config (contains project-specific keys)
lib/firebase_options.dart.bak

